# Translation
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
SOURCE_LANGUAGE=JPN
TARGET_LANGUAGE=CHT
TRANSLATION_PROMPT_FILE=prompts/translation.txt
CORRECTION_PROMPT_FILE=prompts/correction.txt

# Output
OUTPUT_DIR=output
OUTPUT_FORMAT=jpg
OUTPUT_JPEG_QUALITY=92

# Rendering
FONT_PATH=C:/Windows/Fonts/NotoSansCJKtc-Regular.otf
FONT_SIZE=48
MAX_FONT_SIZE=64
MIN_FONT_SIZE=10
TEXT_PADDING=4
RENDERER_ENGINE=mask
TEXT_DIRECTION=vertical-rtl
TEXT_ANCHOR_ENGINE=opencv-ink
TEXT_ANCHOR_BORDER_MARGIN=5

# OCR
OCR_MODEL_DIR=models

# Region detection
PIPELINE_MODE=two-stage
YOLO_MODEL_PATH=models/manga109_yolo/model.pt
YOLO_CONFIDENCE=0.25
BUBBLE_MODEL_PATH=models/manga109-segmentation-bubble/best.pt
BUBBLE_CONFIDENCE=0.25

# Inpainting
INPAINT_ENABLED=true
INPAINT_ENGINE=opencv
TEXT_DARK_THRESHOLD=160
WHITE_BACKGROUND_THRESHOLD=235
WHITE_BACKGROUND_RATIO=0.70
INPAINT_RADIUS=3
MASK_DILATION=1
BUBBLE_PADDING=80
BUBBLE_CLOSE_KERNEL=13
BUBBLE_CLEAR_MODE=interior
BUBBLE_MIN_OVERLAP=0.25
BUBBLE_BORDER_WIDTH=3