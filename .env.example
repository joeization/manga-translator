# Translation
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=Sakura-Galtransl-7B-v3.7
SOURCE_LANGUAGE=Japanese
TARGET_LANGUAGE=Chinese
TRANSLATION_PROMPT_FILE=prompts/translation.txt
CORRECTION_PROMPT_FILE=prompts/correction.txt

# Output
OUTPUT_DIR=output
OUTPUT_FORMAT=jpg
OUTPUT_JPEG_QUALITY=92

# Rendering
FONT_PATH=C:/Windows/Fonts/NotoSansCJKtc-Bold.otf
FONT_SIZE=56
MAX_FONT_SIZE=72
MIN_FONT_SIZE=12
TEXT_PADDING=4
RENDERER_ENGINE=mask
TEXT_DIRECTION=vertical-rtl
TEXT_ANCHOR_ENGINE=opencv-ink

# OCR
OCR_ENGINE=baberu
OCR_MODEL_DIR=models
# Minimum OCR quality score [0-1] to allow translation. Lower = more permissive.
OCR_MIN_TRANSLATION_CONFIDENCE=0.65

# Region detection
PIPELINE_MODE=hybrid
YOLO_MODEL_PATH=models/manga109_yolo/model.pt
YOLO_CONFIDENCE=0.25
BUBBLE_MODEL_PATH=models/manga109-segmentation-bubble/best.pt
BUBBLE_CONFIDENCE=0.25

# Inpainting
INPAINT_ENABLED=true
INPAINT_ENGINE=lama
# interior: erase entire bubble contents (fastest, best for plain white bubbles)
# glyph: detect individual glyphs (better for coloured/gradient backgrounds)
BUBBLE_CLEAR_MODE=interior
LAMA_MODEL_PATH=models/inpainting_lama/lama-manga.onnx
LAMA_DEVICE=gpu
